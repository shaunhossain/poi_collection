# Barikoi Map Configuration
NEXT_PUBLIC_BARIKOI_API_KEY=your_barikoi_api_key_here
NEXT_PUBLIC_BARIKOI_ADMIN_KEY=your_barikoi_admin_key_here
NEXT_PUBLIC_MAP_STYLE_URL=https://map.barikoi.com/styles/osm_barikoi_v1/style.json

# ThirdEye360 Vector Tile Source
NEXT_PUBLIC_THIRDEYE_TILE_URL=https://tiles.bmapsbd.com/ThirdEye360

# NestJS Backend API URL
NEXT_PUBLIC_API_BASE_URL=http://localhost:4000

# Default Map Center (Dhaka, Bangladesh)
NEXT_PUBLIC_DEFAULT_LAT=23.8103
NEXT_PUBLIC_DEFAULT_LNG=90.4125
NEXT_PUBLIC_DEFAULT_ZOOM=14

# Server Configuration
PORT=3000
